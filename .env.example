# Copy this file to ".env" (same folder) and fill in your PAPER keys.
# Get them at https://app.alpaca.markets -> switch to "Paper" -> API Keys.
# Never put real values in .env.example, and never commit .env.

# Paper key IDs start with "PK". Live keys (starting "AK") are refused.
ALPACA_API_KEY=PK_your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Must be the paper endpoint. Anything else stops the program.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Only "paper" is accepted.
TRADING_MODE=paper

# The balance you reset your Alpaca paper account to (for display and checks).
STARTING_BALANCE=1000

# Local SQLite database file (relative to the options-bot folder).
DATABASE_URL=sqlite:///data/options_bot.db

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
